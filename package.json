{
  "name": "tennis-move-backend",
  "version": "1.0.0",
  "description": "A Node.js backend for the **Tennis Move** project. Runs in development and production, with generated build artifacts in `dist/`.   **API docs** are available at `GET /docs` when the server is running.",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
