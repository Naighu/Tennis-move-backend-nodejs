    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "jwk-to-pem": "^2.0.7",
    "jwks-rsa": "^4.0.1",
    "openapi3-ts": "^4.5.0",
    "pg": "^8.16.3",
    "puppeteer": "^24.36.1",
